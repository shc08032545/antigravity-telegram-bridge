# ============================================================
# Antigravity Web <-> Telegram Bot Bridge Configuration
# ============================================================

# [REQUIRED] Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# [SECURITY] Whitelist of Telegram User IDs allowed to control the bot (comma-separated).
# Tip: Run the bot and send /whoami to discover your Telegram User ID.
ALLOWED_USER_IDS=

# [OPTIONAL] Whitelist of Telegram Chat IDs (for group chats or specific chats, comma-separated).
ALLOWED_CHAT_IDS=

# [DANGER] Set to true ONLY for local testing if you want to allow all users without a whitelist.
ALLOW_ALL_USERS=false

# Chrome DevTools Protocol (CDP) endpoint URL
CHROME_CDP_URL=http://127.0.0.1:9222

# Substring or regex pattern used to auto-detect the Antigravity Web tab URL or title
ANTIGRAVITY_URL_MATCH=antigravity

# Maximum time (ms) to wait for Antigravity Web to finish replying (default: 5 minutes)
RESPONSE_TIMEOUT_MS=300000

# How long (ms) the response text must remain unchanged with no stop button before finishing
RESPONSE_STABLE_MS=2500

# Polling interval (ms) while reading response changes from the page
POLL_INTERVAL_MS=800

# Stream live partial updates to Telegram while Antigravity Web is generating
STREAM_UPDATES=true

# Minimum interval (ms) between Telegram live-edit updates (avoid rate limits)
STREAM_EDIT_INTERVAL_MS=2500

# Optional path to custom DOM selector overrides JSON file
SELECTORS_CONFIG_PATH=./selectors.json

# Max attachment size (MB) accepted from Telegram (Telegram Bot API standard limit is 20MB)
MAX_FILE_SIZE_MB=20

# Logging level: debug | info | warn | error
LOG_LEVEL=info
